FROM python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535
COPY requirements-sandbox.hashes.txt /tmp/requirements-sandbox.hashes.txt
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements-sandbox.hashes.txt && python -m pip check
ENV PYTHONDONTWRITEBYTECODE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
WORKDIR /workspace
USER 65534:65534
ENTRYPOINT ["python"]
